    "default": 600
  },
  "min_rarity": {
    "description": "出题池最低稀有度（1-6）",
    "type": "int",
    "default": 1
  },
  "render_mode": {
    "description": "对局结果输出形式；image 使用本地 Pillow 生成 PNG，失败自动回退 text",
    "type": "string",
    "default": "image",
    "options": ["image", "text"]
  }
